APP_NAME=Payment API Test
APP_VERSION=0.1.0
APP_DESCRIPTION=Payment gateway test configuration
APP_HOST=127.0.0.1
APP_PORT=8000
APP_WORKERS=1
DEBUG=false

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=payment_db_test
DATABASE_USER=postgres
DATABASE_PASSWORD=password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

BROKER_HOST=127.0.0.1
BROKER_PORT=5672
BROKER_USER=guest
BROKER_PASSWORD=guest

PROVIDER_URL=http://127.0.0.1:8001
WEBHOOK_BASE_URL=http://127.0.0.1:8000
PROVIDER_WEBHOOK_SECRET=change-me-provider-webhook-secret

PROVIDER_DELAY_MIN=0.0
PROVIDER_DELAY_MAX=0.0

